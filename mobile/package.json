{
  "name": "smarthire-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:demo": "node ./scripts/start-demo.js",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "preflight": "node ./scripts/preflight.js",
    "eas:init": "npx eas-cli@latest init",
    "eas:configure": "npx eas-cli@latest build:configure",
    "build:android:development": "npx eas-cli@latest build --platform android --profile development",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production",
    "build:ios:development": "npx eas-cli@latest build --platform ios --profile development",
    "build:ios:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "build:ios:production": "npx eas-cli@latest build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "axios": "^1.13.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.0",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  }
}
