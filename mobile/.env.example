# Copy this file to mobile/.env. Never commit the real .env.
# Values prefixed EXPO_PUBLIC_ are embedded in the app bundle: never put secrets here.

# development | preview | production. EAS profiles set this automatically for cloud builds.
EXPO_PUBLIC_APP_ENV=development

# Android emulator: http://10.0.2.2:5000
# iOS simulator:     http://localhost:5000
# Physical device:    http://YOUR-LAN-IP:5000  (development only)
# Preview/production: https://api.your-domain.example
# Set this explicitly; leaving it blank makes the preflight fail rather than building against a stale LAN address.
EXPO_PUBLIC_API_URL=

# Optional public browser URL for an intentional future website continuation.
# Native timed assessments and typed mock interviews do not depend on this URL;
# it is intentionally never inferred from EXPO_PUBLIC_API_URL.
# Example: https://smarthire.your-domain.example
EXPO_PUBLIC_WEB_URL=

# Device notification setup deliberately uses no EXPO_PUBLIC credential.
# Expo project ID and the Firebase Android app config live in app.json / the
# local google-services.json file. Firebase service-account keys belong only in
# Firebase/EAS credential management, never in this file or the app bundle.
# The persisted authenticated inbox continues to work even before push setup.
