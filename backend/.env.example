# ── Backend environment (Phase 1) ──
# Copy to backend/.env and fill in real values. NEVER commit the real .env.

# Server
PORT=5000
NODE_ENV=development
# URL of the frontend (used in email links & CORS)
CLIENT_URL=http://localhost:3000

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — backend only, bypasses RLS. Keep secret!
SUPABASE_SERVICE_KEY=your-service-role-key

# Auth
# Long random string used to sign our JWTs
JWT_SECRET=change-me-to-a-long-random-secret

# Email (OTP codes + company-on-campus notifications)
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your-app-password

# Judge0 (DSA / OA code execution) — optional for Phase 1
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
