# SmartHire backend environment template
# Copy to backend/.env for local development. Do NOT commit backend/.env.
# All values here are server-side secrets except PORT, NODE_ENV, and CLIENT_URL.

# Runtime
NODE_ENV=development
PORT=5000
# Exact browser origin allowed by the Express CORS configuration (no trailing slash).
CLIENT_URL=http://localhost:3000

# Supabase — Project Settings -> API
# Use the project URL and the service_role key. The service_role key bypasses RLS;
# it belongs only on this Express server, never in frontend or mobile variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# JWT used by SmartHire's own Express session tokens.
# Generate a long random value, for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# SMTP sender for registration OTPs and SmartHire emails.
# With Gmail, EMAIL_PASS is an App Password, not the account password.
# Leave both blank only if you intentionally want email delivery to fail in local troubleshooting.
EMAIL_USER=you@example.com
EMAIL_PASS=REPLACE_WITH_SMTP_OR_GMAIL_APP_PASSWORD

# Optional but required for live DSA Run/Submit through the normal cloud runner.
# Keep these backend-only; never use REACT_APP_* or EXPO_PUBLIC_* for them.
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

# Development-only escape hatch for a trusted local machine. It executes learner
# code on the API host, so NEVER set this to true in preview or production.
ALLOW_LOCAL_CODE_RUNNER=false

# Remote Android/iOS delivery is best-effort through Expo Push Service. The
# persisted notifications table remains the source of truth even when this is
# false or Expo/FCM is unavailable. Set true only after applying migrations
# 009 and 010, completing Firebase + EAS setup, and deploying the trusted
# 15-minute `npm run process:expo-push-receipts` scheduler from SETUP.md.
# This is not a credential; Firebase service-account keys stay in EAS/Firebase.
EXPO_PUSH_ENABLED=false

# Optional Expo server access token, only when Expo Push access-token security
# is enabled for the linked EAS project. Keep it in the host secret manager;
# never put it in mobile configuration or an EXPO_PUBLIC_* variable.
EXPO_PUSH_ACCESS_TOKEN=
